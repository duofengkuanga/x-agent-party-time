{
  "name": "agent-party-time",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev-all.ts",
    "dev:app": "bun --cwd apps/web dev",
    "status": "bun scripts/dev-processes.ts status",
    "stop": "bun scripts/dev-processes.ts stop",
    "build:app": "bun --cwd apps/web build",
    "start:app": "bun --cwd apps/web start",
    "seed:app": "bun --cwd apps/web seed",
    "dev:runner": "bun packages/runner/src/index.ts start",
    "runner:pair": "bun packages/runner/src/index.ts pair",
    "runner:bind": "bun packages/runner/src/index.ts bind",
    "format:check": "prettier --check README.md .prettierrc.json package.json tsconfig.base.json 'scripts/**/*.ts' 'packages/**/package.json' 'packages/**/tsconfig.json' 'packages/**/src/**/*.ts' 'apps/**/{app,features,server,scripts}/**/*.{ts,tsx,css}' 'apps/**/{package.json,tsconfig.json,next.config.mjs}'",
    "test": "bun test",
    "check:deps": "bun install --frozen-lockfile",
    "typecheck": "bun run typecheck:execution-contract && bun run typecheck:runner-contract && bun run typecheck:runner && bun run typecheck:app",
    "typecheck:execution-contract": "bunx tsc --noEmit -p packages/execution-contract/tsconfig.json",
    "typecheck:app": "bunx tsc --noEmit -p apps/web/tsconfig.json",
    "runner": "bun packages/runner/src/index.ts",
    "typecheck:runner-contract": "bunx tsc --noEmit -p packages/runner-contract/tsconfig.json",
    "typecheck:runner": "bunx tsc --noEmit -p packages/runner/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
