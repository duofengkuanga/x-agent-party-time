{
  "extends": "../../tsconfigBase.json",
  "compilerOptions": {
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node", "bun"]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "server/**/*.ts",
    "contracts/**/*.ts",
    "scripts/**/*.ts",
    "testing/**/*.ts",
    ".next/types/**/*.ts",
    "../../scripts/evaluateObservability.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
